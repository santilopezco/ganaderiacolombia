---
import { getCollection } from "astro:content";

const articulos = (await getCollection("blog"))
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf())
  .slice(0, 3);
---
<section id="aprender">
  <div class="wrap">
    <div class="sec-head">
      <span class="kicker">Aprender</span>
      <h2>Lo que está cambiando en la ganadería colombiana</h2>
      <p>Explicado sin enredos, para que usted decida con criterio y no por lo que le dijeron en la feria.</p>
    </div>
    <div class="notas">
      {articulos.map((articulo) => (
        <a class="nota-card" href={`/blog/${articulo.id}`}>
          <span class="meta">{articulo.data.categoria} · {articulo.data.minutos} min</span>
          <h3>{articulo.data.titulo}</h3>
          <p>{articulo.data.resumen}</p>
          <span>Leer la guía →</span>
        </a>
      ))}
    </div>
  </div>
</section>
